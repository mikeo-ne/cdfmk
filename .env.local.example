# ─────────────────────────────────────────────────────────────
# CDF Muhoozi 2031 Endorsement Portal — environment configuration
# Copy to .env.local and fill in. Restart `npm run dev` after.
# NOTE: NEXT_PUBLIC_* variables are inlined at build time — rebuild
# after changing them.
# ─────────────────────────────────────────────────────────────

# Supabase (https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by API routes for trusted writes (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Africa's Talking SMS (https://account.africastalking.com)
# Use username "sandbox" with a sandbox API key for testing.
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
# Optional sender ID (requires registration on live account)
AT_SENDER_ID=Muhoozi2031
